EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
EXPO_PUBLIC_ORDER_WEBSITE_URL=https://tapstamp.co
EXPO_PUBLIC_SUPPORT_EMAIL=support@tapstamp.co
# In-person: stamp free via Settings → In-person onboard. Optional one-time kit link only:
# EXPO_PUBLIC_IN_PERSON_PAYMENT_LINK=https://buy.stripe.com/...  (must be one-time kit, NOT Pro £25/mo)
# Customer tap/pass/share links (Railway proxy) — never use raw *.supabase.co in production
EXPO_PUBLIC_FUNCTIONS_URL=https://tapstamp.co
EXPO_PUBLIC_TAP_BASE_URL=https://tapstamp.co

# Dev sign-in (local / development builds ONLY — do not set on EAS production)
# EXPO_PUBLIC_DEV_EMAIL=your@email.com
# EXPO_PUBLIC_DEV_PASSWORD=yourpassword
# EXPO_PUBLIC_DEV_BOOTSTRAP_SECRET=tapstamp-dev-local
# Supabase secret (must match): supabase secrets set DEV_BOOTSTRAP_SECRET=tapstamp-dev-local

# Admin tools in the owner app (optional; omit from App Store builds if unused)
# EXPO_PUBLIC_ADMIN_EMAILS=you@example.com
# EXPO_PUBLIC_ADMIN_SECRET=must-match-supabase-ADMIN_SECRET

# Edge function secrets
# GOOGLE_WALLET_ISSUER_ID=your_issuer_id
# GOOGLE_WALLET_SERVICE_ACCOUNT=service-account@project.iam.gserviceaccount.com
# GOOGLE_WALLET_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
# GOOGLE_WALLET_ORIGINS=https://tapstamp.co,https://your-project.supabase.co
# GOOGLE_WALLET_REVIEW_STATUS=UNDER_REVIEW
# After Google publishing access: GOOGLE_WALLET_REVIEW_STATUS=APPROVED
# FUNCTIONS_PUBLIC_URL=https://tapstamp.co
# Edge function secrets (set via `supabase secrets set`, never commit)
# STRIPE_SECRET_KEY=sk_live_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_HARDWARE_PRICE_ID=price_...
# STRIPE_PRO_PRICE_ID=price_...   # £25/mo
# STRIPE_MULTI_PRICE_ID=price_... # £59/mo
# NFC shop (stands / epoxy) — or tag products with metadata tapstamp_sku=
# STRIPE_PRICE_GOOGLE_STAND=price_...
# STRIPE_PRICE_INSTAGRAM_STAND=price_...
# STRIPE_PRICE_GOOGLE_EPOXY=price_...
# STRIPE_PRICE_INSTAGRAM_EPOXY=price_...
# ORDER_WEBSITE_URL=https://tapstamp.co
# Push to your phone when someone orders (Expo push token from a signed-in admin device)
# ORDER_NOTIFY_EXPO_PUSH_TOKEN=ExponentPushToken[...]
# Live setup: STRIPE_SECRET_KEY=sk_live_... npm run stripe:setup && npm run stripe:apply-secrets

# Offer A NFC→loyalty nurture emails (Supabase edge — never commit real keys)
# RESEND_API_KEY=re_...
# EMAIL_API_KEY=re_...                 # alias for RESEND_API_KEY
# EMAIL_FROM=TapStamp <noreply@tapstamp.co>
# EMAIL_REPLY_TO=support@tapstamp.co
# NFC_LOYALTY_NURTURE_ENABLED=true     # defaults on in code; set false/0/off to pause
# NFC_NURTURE_CRON_SECRET=long-random-string
# ADMIN_EMAILS=you@example.com         # optional ops email on hardware paid
